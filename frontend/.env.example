# ─────────────────────────────────────────────────────────────────────────────
# Passmed frontend — example environment file.
# Copy to `.env` and fill in per deployment. The SAME codebase is deployed to
# every region; only the values below change per build.
# ─────────────────────────────────────────────────────────────────────────────

# ── GA4 ANALYTICS (per-region) ───────────────────────────────────────────────
# GA4 Measurement ID for this deployment. Each region sets its OWN id; the app
# never hardcodes it (read via NUXT_PUBLIC_GTAG_ID in nuxt.config.ts). All sites
# feed one GA4 property. Cross-domain linking is intentionally OFF — these are
# independent regional sites.
#
#   Domain (region)                  → Measurement ID
#   ───────────────────────────────────────────────────
#   www.passmed.com      (US)        → G-QGK4J5NGCL
#   www.passmed.co.za    (SA)        → G-80L1Y09M9Q
#   www.passmed.uk       (UK)        → G-BRYENT61EJ
#   www.passmed.ca       (CA)        → G-F2JLP3DE1G  (migrating from www.mccqeprep.com)
#   www.passamc.org      (AU)        → G-7JWYC4Y9NS
#   www.passmed.ph       (PH)        → G-5SZJYN35C2
#
NUXT_PUBLIC_GTAG_ID=G-QGK4J5NGCL

# Region code for this deployment. Attached to EVERY GA4 event as the `region`
# param (→ Region custom dimension) and selects the ISO currency for ecommerce
# events. One of: US | SA | UK | CA | AU | PH. If unset, useAnalytics falls back
# to detecting the region from the hostname.
#
#   Region → currency:  US→USD  SA→ZAR  UK→GBP  CA→CAD  AU→AUD  PH→PHP
#
NUXT_PUBLIC_REGION=US

# ── AD PLATFORMS (per-region, optional) ──────────────────────────────────────
# Meta (Facebook) Pixel + Google Ads. All OPTIONAL: leave blank and the tags
# never load (GA4 keeps working). The Pixel loads ONLY after the user grants
# "Marketing" cookie consent; Google Ads rides on gtag.js under Consent Mode.
# useAnalytics fires the matching events automatically (ViewContent / AddToCart /
# InitiateCheckout / AddPaymentInfo / Purchase, and the Ads purchase conversion).
#
# Meta Pixel ID for this region (numeric). Each market's Pixel ID is resolved at
# RUNTIME from the request host (app/composables/useRegion.ts → REGION_META_PIXEL),
# so leaving this blank uses the correct per-market default. Set it only to
# OVERRIDE. (Domain-verification <meta> tags are injected the same way, via
# app/plugins/domain-verify.ts — no dependency on NUXT_PUBLIC_REGION.)
NUXT_PUBLIC_META_PIXEL_ID=
# Google Ads conversion account + the PURCHASE conversion label. Both required to
# fire the Ads conversion on purchase. Format: AW-XXXXXXXXX and the label string.
NUXT_PUBLIC_GOOGLE_ADS_ID=
NUXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=

# ── BACKEND / API ────────────────────────────────────────────────────────────
# Server-only: where Laravel actually lives. The browser never sees this.
NUXT_LARAVEL_API=https://api.passmed.com/frontend/v1

# Public site URL (used for absolute links / canonical URLs).
NUXT_PUBLIC_SITE_URL=https://www.passmed.com

# ── PAYMENTS / AUTH / FORMS ──────────────────────────────────────────────────
# Stripe publishable key for this deployment (test or live).
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# Google OAuth client id (Google sign-in / signup button).
NUXT_PUBLIC_GOOGLE_AUTH_KEY=

# Cloudflare Turnstile site key for the public contact / institutions forms.
# When unset, the widget is inert (no widget, no token).
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# Settings key for CMS-driven header/footer chrome (useSiteChrome).
NUXT_PUBLIC_CHROME_SETTINGS_KEY=
